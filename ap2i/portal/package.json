{
  "name": "ap2i-portal",
  "version": "0.1.0",
  "private": true,
  "description": "AP²I — public interactive portal over the read-only data snapshot",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node --test e2e/portal.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "maplibre-gl": "6.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "^22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  }
}
