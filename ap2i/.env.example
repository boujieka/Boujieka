# Copy to .env and fill in. Never commit .env. All backend variables use the AP2I_ prefix.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
AP2I_ENVIRONMENT=production
# >= 32 random characters, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
AP2I_SECRET_KEY=change-me
AP2I_ACTIVE_COUNTRIES=["CMR"]
AP2I_DEFAULT_COUNTRY=CMR
AP2I_CORS_ORIGINS=["http://localhost:3000"]
AP2I_PUBLIC_APP_URL=http://localhost:3000

# Email (console = log only; smtp = send)
AP2I_EMAIL_BACKEND=console
# AP2I_SMTP_HOST=
# AP2I_SMTP_USER=
# AP2I_SMTP_PASSWORD=
# AP2I_EMAIL_FROM=no-reply@your-domain

# Optional: official IATI Datastore subscription key (https://developer.iatistandard.org). Without it the
# public Code for IATI mirror is used.
# AP2I_IATI_API_KEY=

# Optional AI narrative (the assistant works without it): none | anthropic | openai_compatible
AP2I_LLM_PROVIDER=none
# AP2I_LLM_MODEL=
# AP2I_LLM_API_KEY=
# AP2I_LLM_BASE_URL=

# Payments stay disabled until a provider is implemented and compliance-reviewed.
AP2I_PAYMENT_PROVIDER=none
