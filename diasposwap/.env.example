# DiaspoSwap - example configuration. Copy to .env and replace every value. Never commit .env.
# Mode: only SIMULATION exists in this version.

# Admin API keys, comma separated "key:role" (roles: ops, compliance). Use long random values.
DIASPOSWAP_ADMIN_KEYS=replace-with-random-ops-key:ops,replace-with-random-compliance-key-1:compliance,replace-with-random-compliance-key-2:compliance
# HMAC secret shared with the (simulated) payment providers for webhook signatures.
DIASPOSWAP_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Seed 1000 fictional users / 5000 orders at startup.
DIASPOSWAP_SEED_DEMO=true
PORT=3000

# Phase 4 (not used yet)
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://diasposwap:replace-me@localhost:5432/diasposwap
REDIS_URL=redis://localhost:6379

# Ledger persistence (Phase 4, ledger only). Tests create throwaway databases through this admin connection;
# the role needs CREATEDB.
TEST_DATABASE_URL=postgresql://diasposwap:replace-me@localhost:5432/postgres
