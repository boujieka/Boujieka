# DiaspoSwap API - simulation mode. Build from the diasposwap/ directory:
#   docker build -f infrastructure/Dockerfile.api -t diasposwap-api .
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
# the mobile workspace is not needed in the API image
RUN npm ci --workspace apps/api --include-workspace-root=false --ignore-scripts
ENV NODE_ENV=production
USER node
EXPOSE 3000
WORKDIR /app/apps/api
CMD ["npx", "tsx", "src/main.ts"]
