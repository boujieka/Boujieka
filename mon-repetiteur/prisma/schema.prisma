// Mon Répétiteur — database schema.
//
// Covers: users (students/parents/tutors), the French national curriculum
// (subjects × grade levels × topics), the exercise bank, exams, AI tutor
// session history, and per-topic student progress.
//
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  PARENT
  TUTOR
  ADMIN
}

/// Grade levels covered by the French national curriculum (Éducation
/// nationale): collège (6e–3e) and lycée (2nde–terminale).
enum SchoolLevel {
  SIXIEME
  CINQUIEME
  QUATRIEME
  TROISIEME
  SECONDE
  PREMIERE
  TERMINALE
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String?
  role         Role    @default(STUDENT)

  /// Only meaningful for STUDENT accounts.
  schoolLevel SchoolLevel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // As a student, the parents/tutors linked to this account.
  guardianLinks ParentStudentLink[] @relation("StudentGuardians")
  // As a parent/tutor, the student accounts linked to this account.
  studentLinks  ParentStudentLink[] @relation("GuardianStudents")

  exerciseAttempts ExerciseAttempt[]
  examAttempts     ExamAttempt[]
  tutorSessions    TutorSession[]
  topicProgress    TopicProgress[]

  @@index([role])
  @@map("users")
}

/// Many-to-many link between a guardian (PARENT or TUTOR role) and the
/// student accounts they can view progress for.
model ParentStudentLink {
  id String @id @default(cuid())

  guardianId String
  guardian   User   @relation("GuardianStudents", fields: [guardianId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("StudentGuardians", fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([guardianId, studentId])
  @@index([studentId])
  @@map("parent_student_links")
}

// ---------------------------------------------------------------------------
// Curriculum
// ---------------------------------------------------------------------------

model Subject {
  id   String @id @default(cuid())
  /// URL/code-friendly identifier, e.g. "maths", "francais", "histoire-geo".
  slug String @unique
  name String

  topics CurriculumTopic[]
  exams  Exam[]

  @@map("subjects")
}

/// A chapter/topic in the programme scolaire for one subject at one grade
/// level. Self-referencing so chapters can have sub-topics.
model CurriculumTopic {
  id String @id @default(cuid())

  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level     SchoolLevel

  title       String
  description String?
  /// Display order among siblings.
  order       Int     @default(0)

  parentId String?
  parent   CurriculumTopic?  @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children CurriculumTopic[] @relation("TopicHierarchy")

  exercises Exercise[]
  progress  TopicProgress[]

  @@index([subjectId, level])
  @@index([parentId])
  @@map("curriculum_topics")
}

// ---------------------------------------------------------------------------
// Exercises
// ---------------------------------------------------------------------------

enum ExerciseType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  FREE_RESPONSE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Exercise {
  id String @id @default(cuid())

  topicId String
  topic   CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  type       ExerciseType
  difficulty Difficulty   @default(MEDIUM)
  prompt     String
  /// Shape depends on `type`: choices + correct index for MULTIPLE_CHOICE,
  /// expected answer(s) for SHORT_ANSWER, a rubric for FREE_RESPONSE, etc.
  content    Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts      ExerciseAttempt[]
  examQuestions ExamQuestion[]

  @@index([topicId, difficulty])
  @@map("exercises")
}

model ExerciseAttempt {
  id String @id @default(cuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  answer      Json
  isCorrect   Boolean
  score       Float?
  attemptedAt DateTime @default(now())

  @@index([userId, exerciseId])
  @@map("exercise_attempts")
}

// ---------------------------------------------------------------------------
// Exams
// ---------------------------------------------------------------------------

model Exam {
  id String @id @default(cuid())

  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level     SchoolLevel

  title           String
  description     String?
  durationMinutes Int

  createdAt DateTime @default(now())

  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([subjectId, level])
  @@map("exams")
}

/// Join table: which exercises appear on an exam, and in what order.
model ExamQuestion {
  id String @id @default(cuid())

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  order Int @default(0)

  answers ExamAnswer[]

  @@unique([examId, exerciseId])
  @@map("exam_questions")
}

model ExamAttempt {
  id String @id @default(cuid())

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Float?

  answers ExamAnswer[]

  @@index([examId, userId])
  @@map("exam_attempts")
}

model ExamAnswer {
  id String @id @default(cuid())

  examAttemptId String
  examAttempt   ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)

  examQuestionId String
  examQuestion   ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)

  answer    Json
  isCorrect Boolean?

  @@unique([examAttemptId, examQuestionId])
  @@map("exam_answers")
}

// ---------------------------------------------------------------------------
// AI Tutor
// ---------------------------------------------------------------------------

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model TutorSession {
  id String @id @default(cuid())

  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Optional curriculum context the session is anchored to.
  topicId String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  messages TutorMessage[]

  @@index([userId])
  @@map("tutor_sessions")
}

model TutorMessage {
  id String @id @default(cuid())

  sessionId String
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@map("tutor_messages")
}

// ---------------------------------------------------------------------------
// Progress
// ---------------------------------------------------------------------------

/// Rolling mastery estimate for one student on one curriculum topic,
/// derived from exercise/exam/tutor activity.
model TopicProgress {
  id String @id @default(cuid())

  userId  String
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId String
  topic   CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  /// 0–1 mastery estimate.
  masteryScore Float    @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([userId, topicId])
  @@map("topic_progress")
}
