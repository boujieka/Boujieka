# Copy this file to .env and fill in real values. .env is gitignored.
#
# For local dev, run `npm run db:start` (Supabase CLI local stack) and copy
# the printed API_URL / ANON_KEY / SERVICE_ROLE_KEY values below — or just
# run `npx supabase status` once the stack is up.

NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. NEVER expose this to the client (CLAUDE.md §12).
SUPABASE_SERVICE_ROLE_KEY=""

# AI Tutor (src/services/ai/). Without this, the tutor UI still works —
# messages are saved, but /tutor shows "not configured" instead of a reply
# (see src/services/ai/tutor.ts's getProvider()).
ANTHROPIC_API_KEY=""
# Optional override; defaults to claude-sonnet-5 (see anthropic-provider.ts).
ANTHROPIC_MODEL=""
