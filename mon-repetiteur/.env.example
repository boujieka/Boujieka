# Copy this file to .env and fill in real values. .env is gitignored.
#
# For local dev, run `npm run db:start` (Supabase CLI local stack) and copy
# the printed API_URL / ANON_KEY / SERVICE_ROLE_KEY values below — or just
# run `npx supabase status` once the stack is up.

NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. NEVER expose this to the client (CLAUDE.md §12).
SUPABASE_SERVICE_ROLE_KEY=""

# API key for the AI Tutor phase (Anthropic Claude API). Not needed until that phase.
ANTHROPIC_API_KEY=""
