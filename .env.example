# Copy to .env (never commit .env). Backend variables use the ABI_ prefix.
ABI_DATABASE_URL=postgresql+psycopg://abi:abi@localhost:5432/abi
ABI_CORS_ORIGINS=["http://localhost:3000"]
ABI_SOURCE_STALE_AFTER_HOURS=48
ABI_LOW_CONFIDENCE_THRESHOLD=0.7

# Frontend (server-side only; never exposed to the browser)
ABI_API_URL=http://localhost:8000/api/v1

# Tests: point at a THROWAWAY database to run the backend suite on Postgres
# ABI_TEST_DATABASE_URL=postgresql+psycopg://abi:abi@localhost:5432/abi_test
