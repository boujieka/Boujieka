# ---------------------------------------------------------------------------
# ATEN — variables d'environnement
# Copier ce fichier vers `.env` et renseigner les valeurs.
# ---------------------------------------------------------------------------

# Base de données PostgreSQL
DATABASE_URL="postgresql://aten:aten@localhost:5432/aten?schema=public"

# Secret de signature des sessions JWT (générer : openssl rand -base64 48)
AUTH_SECRET="change-me-with-a-long-random-secret"

# ---------------------------------------------------------------------------
# API Claude — CÔTÉ SERVEUR UNIQUEMENT. Ne jamais exposer au client.
# La clé n'est lue que dans src/lib/ai/* (code serveur). Voir README.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Modèles par tâche (surchargeables). Défauts raisonnables ci-dessous.
ANTHROPIC_MODEL_QUALIFICATION="claude-opus-4-8"
ANTHROPIC_MODEL_CONCEPT_NOTE="claude-opus-4-8"
ANTHROPIC_MODEL_MATCHING="claude-haiku-4-5-20251001"

# NASA POWER (API publique, pas de clé requise)
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal/hourly/point"

# Paramètres physiques par défaut de la simulation (surchargeables par étude)
ATEN_PERFORMANCE_RATIO="0.80"
ATEN_BATTERY_ROUND_TRIP="0.90"
ATEN_BATTERY_DOD="0.90"
ATEN_BATTERY_C_RATE="0.50"
