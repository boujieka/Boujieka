# Mini-Grid Financial Model Studio — environment variables (copy to backend/.env).
# Never commit real values. Production secrets come from a secret manager.

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver)
MGS_DATABASE_URL=postgresql+psycopg://mgs:CHANGE_ME@localhost:5432/mgs
# Database used by the API integration tests (its schema is dropped and recreated)
MGS_TEST_DATABASE_URL=postgresql+psycopg://mgs:CHANGE_ME@localhost:55432/mgs_test

# Bearer token lifetime, hours
MGS_TOKEN_TTL_HOURS=12
# Allow self-service creation of organisations (POST /api/v1/auth/signup)
MGS_ALLOW_SIGNUP=false
# Upload size limit for workbook imports, MB
MGS_MAX_UPLOAD_MB=10
# Allowed browser origins for the future web front-end (JSON list)
MGS_CORS_ORIGINS=[]
# Login attempts allowed per minute, per account and (separately) per client IP
MGS_LOGIN_ATTEMPTS_PER_MINUTE=10
MGS_LOGIN_ATTEMPTS_PER_IP_MINUTE=50
# Trust X-Forwarded-For for the client IP (only behind your own reverse proxy)
MGS_TRUSTED_PROXY=false
# Invitation validity, days
MGS_INVITATION_TTL_DAYS=7
# Maximum JSON request body, KB (also enforce a body limit at the reverse proxy)
MGS_MAX_JSON_BODY_KB=2048
# Serve the interactive API docs at /docs (keep false in production)
MGS_EXPOSE_DOCS=false

# Demo seeding only (python -m app.demo.seed); no default password exists
MGS_DEMO_ADMIN_EMAIL=
MGS_DEMO_ADMIN_PASSWORD=

# No paid API and no generative-AI key is used by Phase 1.
