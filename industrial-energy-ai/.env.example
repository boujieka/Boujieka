# Copy to .env and adjust. Never commit the real .env file.
# Database (SQLite by default; a PostgreSQL URL such as postgresql+psycopg://user:pass@host/db also works)
IEA_DATABASE_URL=sqlite:///data/industrial_energy_ai.db
# Interface language: fr (default) or en
IEA_LANGUAGE=fr
# AI features are OFF by default. Set to true to show the external provider option.
IEA_AI_ENABLED=false
# Provider: offline (deterministic, no network) or openai
IEA_AI_PROVIDER=offline
IEA_AI_MODEL=gpt-4o-mini
# Required only for the openai provider. Calls cost money: they are made only after explicit
# per-session authorisation in the AI Assistant page.
OPENAI_API_KEY=
# Logging level
IEA_LOG_LEVEL=INFO
